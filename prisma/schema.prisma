generator client {
  provider   = "prisma-client-js"
  engineType = "none"
}

datasource db {
  provider = "postgresql"
  // url は prisma.config.ts の datasource.url で設定（Prisma v7）
}

// ─────────────────────────────────────────────────────────────────────────────
// 認証（NextAuth.js v5 / @auth/prisma-adapter）
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// ユーザー
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  MUSICIAN
  VENUE
  BOTH
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?   // NextAuth PrismaAdapter が要求する標準フィールド（OAuth プロファイルの表示名）
  nickname      String?   // ユーザーが自分で設定するアプリ内ニックネーム
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(MUSICIAN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth.js relations
  accounts Account[]
  sessions Session[]

  // アプリ relations
  musicianProfile  MusicianProfile?
  ownedVenues      Venue[]             @relation("VenueOwner")
  ownedStudios     Studio[]            @relation("StudioOwner")
  connectionsFrom  Connection[]        @relation("ConnectionFrom")
  connectionsTo    Connection[]        @relation("ConnectionTo")
  blocksBy         Block[]             @relation("BlockedBy")
  blocksAgainst    Block[]             @relation("BlockedAgainst")
  notifications    Notification[]
  kudosSent        Kudos[]             @relation("KudosSender")
  kudosReceived    Kudos[]             @relation("KudosReceiver")
  hostedSeries     SessionSeries[]     @relation("SeriesHost")
  feedbackReceived AnonymousFeedback[] @relation("FeedbackReceiver")
  adminSessions    JamSession[]        @relation("SessionAdmin")
  registeredLogs   PerformanceLog[]    @relation("LogRegistrar")
  venuePosts       VenuePost[]         @relation("PostAuthor")
  tendencyPosts    SessionTendency[]   @relation("TendencyAuthor")
}

// ─────────────────────────────────────────────────────────────────────────────
// ミュージシャンプロフィール
// ─────────────────────────────────────────────────────────────────────────────

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ANY
}

enum LevelPref {
  SAME_LEVEL
  JOIN_BETTER
  EITHER
}

enum SessionGoal {
  FUN
  IMPROVE
  BOTH
}

enum PlayVolumePref {
  LOTS
  SPECIFIC_ONLY
  EITHER
}

enum ChallengePref {
  KNOWN_ONLY
  CHALLENGE
  EITHER
}

enum FeedbackPref {
  WELCOME
  LIGHT
  NONE
}

enum SessionStyle {
  DEEP
  VARIETY
  EITHER
}

enum TempoPref {
  SLOW
  MODERATE
  FAST
}

enum ProfileVisibility {
  PRIVATE
  LOGGED_IN
  PUBLIC
}

model MusicianProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  bio               String?           @db.Text
  areaLabel         String?           // 表示用（例: 「柏エリア」）
  areaLat           Float?            // 内部のみ — API から返却しない
  areaLng           Float?            // 内部のみ — API から返却しない
  travelRadiusKm    Int               @default(15)
  skillLevel        SkillLevel        @default(BEGINNER)
  levelPref         LevelPref         @default(EITHER)
  sessionGoal       SessionGoal       @default(BOTH)
  playVolumePref    PlayVolumePref    @default(EITHER)
  challengePref     ChallengePref     @default(EITHER)
  feedbackPref      FeedbackPref      @default(LIGHT)
  sessionStyle      SessionStyle      @default(EITHER)
  tempoPref         TempoPref         @default(MODERATE)
  yearsPlaying      Int?
  snsLinks          Json              @default("{}")
  profileVisibility ProfileVisibility @default(LOGGED_IN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruments   MusicianInstrument[]
  genres        MusicianGenre[]
  coverageAreas MusicianCoverageArea[]  // v0.3: 対応エリア + SYNCROOM
  wishlist      SongWish[]
  registrations JamSessionRegistration[]
  performanceLogs PerformanceLog[]
}

model MusicianInstrument {
  id                String          @id @default(cuid())
  musicianProfileId String
  instrument        String
  proficiency       String?

  musicianProfile MusicianProfile @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)

  @@index([musicianProfileId])
}

model MusicianGenre {
  id                String          @id @default(cuid())
  musicianProfileId String
  genre             String

  musicianProfile MusicianProfile @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)

  @@index([musicianProfileId])
}

// v0.3: 対応エリア（複数登録可）& SYNCROOM 対応フラグ
// isSyncroom=true のレコードが SYNCROOM エントリ（エリア名は「SYNCROOM」等に）
model MusicianCoverageArea {
  id              String          @id @default(cuid())
  musicianProfileId String
  areaLabel       String          // 表示用エリア名（例: 「秋葉原」「柏」）
  areaLat         Float?
  areaLng         Float?
  isHome          Boolean         @default(false) // 拠点エリアかどうか
  isSyncroom      Boolean         @default(false) // SYNCROOM 対応エントリかどうか
  syncroomNotes   String?         // ルーム名・接続環境メモ（任意）
  isPublic        Boolean         @default(false) // 公開可否
  createdAt       DateTime        @default(now())

  musicianProfile MusicianProfile @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)

  @@index([musicianProfileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 会場（セッション会場 — バー・ライブハウス等）
// v0.3: VenueProfile を Venue に変更。誰でも登録可・オーナーは後から認証
// ─────────────────────────────────────────────────────────────────────────────

enum VerificationMethod {
  HP_EMAIL
  SNS_CODE
  MANUAL
}

// v0.3: 情報ソース種別
enum SourceType {
  AUTO_COLLECTED  // Botが自動収集
  CROWDSOURCED    // ミュージシャンが口コミ投稿
  OWNER_VERIFIED  // オーナーが認証・編集
}

model Venue {
  id              String              @id @default(cuid())
  name            String
  address         String?
  lat             Float?              // Geocoding APIからキャッシュ
  lng             Float?
  nearestStation  String?
  walkMinutes     Int?
  websiteUrl      String?
  instagramUrl    String?
  xUrl            String?
  facebookUrl     String?
  bookingUrl      String?
  bookingPhone    String?
  rulesMarkdown   String?             @db.Text // オーナー確認済みのみ公開
  // オーナー認証（ownerId=null = まだ誰もオーナーを主張していない）
  ownerId         String?
  verifiedAt      DateTime?
  verifiedMethod  VerificationMethod?
  verifiedDomain  String?
  disputedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  owner           User?               @relation("VenueOwner", fields: [ownerId], references: [id])
  tendencies      SessionTendency[]
  venuePosts      VenuePost[]
  jamSessions     JamSession[]
  kudos           Kudos[]             @relation("KudosVenueReceiver")
  feedback        AnonymousFeedback[] @relation("FeedbackVenueReceiver")
  collectionJobs  AutoCollectionJob[]
  sessionSeries   SessionSeries[]

  @@index([lat, lng])
}

// v0.3: セッション傾向（1会場に複数登録可。特定日時ではなく曜日・傾向で記述）
model SessionTendency {
  id               String     @id @default(cuid())
  venueId          String
  name             String     // 例: 「木曜ジャズセッション」
  typicalDayOfWeek Int?       // 0=日〜6=土。null=不定期
  typicalStartTime String?    // "19:00" 形式
  typicalEndTime   String?    // "22:00" 形式
  genres           String[]   // ["Jazz", "Blues"]
  atmosphere       String?    @db.Text
  levelRange       String?    // "初心者歓迎" / "中級以上" 等
  entrySystem      String?    // "無料" / "500円" / "ワンドリンク制" 等
  capacity         Int?
  houseEquipment   String?
  equipmentDetails String?    @db.Text
  sourceType       SourceType @default(CROWDSOURCED)
  sourceUserId     String?    // 口コミ投稿者（auto-collected の場合は null）
  sourceUrl        String?    // Bot収集元URL
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  venue            Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sourceUser       User?      @relation("TendencyAuthor", fields: [sourceUserId], references: [id])

  @@index([venueId])
}

// v0.3: 会場への口コミ投稿（傾向以外の自由テキスト情報）
model VenuePost {
  id         String     @id @default(cuid())
  venueId    String
  authorId   String?    // null = auto-collected
  sourceType SourceType @default(CROWDSOURCED)
  sourceUrl  String?
  content    String     @db.Text
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  venue      Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  author     User?      @relation("PostAuthor", fields: [authorId], references: [id])

  @@index([venueId])
}

// v0.3: Bot 収集ジョブの状態管理
model AutoCollectionJob {
  id            String   @id @default(cuid())
  venueId       String?
  studioId      String?
  sourceType    String   // "instagram" | "x" | "hp" | "facebook" | "connpass"
  sourceUrl     String
  lastFetchedAt DateTime?
  lastStatus    String?  // "success" | "error" | "pending_review"
  nextFetchAt   DateTime?
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())

  venue  Venue?  @relation(fields: [venueId], references: [id])
  studio Studio? @relation(fields: [studioId], references: [id])

  @@index([nextFetchAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// スタジオ（練習スタジオ）— v0.3 新規追加
// ─────────────────────────────────────────────────────────────────────────────

model Studio {
  id             String    @id @default(cuid())
  name           String
  address        String?
  lat            Float?
  lng            Float?
  nearestStation String?
  walkMinutes    Int?
  websiteUrl     String?
  phone          String?
  openingHours   String?
  bookingMethod  String?   // "online" | "phone" | "walk-in"
  ownerId        String?
  verifiedAt     DateTime?
  disputedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner          User?             @relation("StudioOwner", fields: [ownerId], references: [id])
  rooms          StudioRoom[]
  jamSessions    JamSession[]
  collectionJobs AutoCollectionJob[]

  @@index([lat, lng])
}

// スタジオの部屋（1スタジオに複数部屋）
model StudioRoom {
  id              String   @id @default(cuid())
  studioId        String
  name            String   // "Room A" / "スタジオ3" 等
  capacityPersons Int?
  sizeSqm         Float?
  hasDrums        Boolean  @default(false)
  drumSpec        String?
  hasPA           Boolean  @default(false)
  paSpec          String?
  hasPiano        Boolean  @default(false)
  hasAmps         Boolean  @default(false)
  hasMics         Boolean  @default(false)
  otherEquipment  String?  @db.Text
  hourlyRateYen   Int?     // 通常時間帯
  hourlyRatePeak  Int?     // ピーク時間帯
  minBookingHours Int?     @default(1)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studio      Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  jamSessions JamSession[]

  @@index([studioId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 曲データベース
// ─────────────────────────────────────────────────────────────────────────────

enum SongDifficulty {
  EASY
  MEDIUM
  HARD
  VARIES
}

model Song {
  id            String         @id @default(cuid())
  title         String
  artist        String?
  genre         String?
  typicalKey    String?
  typicalBpmMin Int?
  typicalBpmMax Int?
  difficulty    SongDifficulty @default(VARIES)
  tags          String[]
  chordwikiUrl  String?
  wishlistCount Int            @default(0)
  submittedById String?
  approved      Boolean        @default(false)
  createdAt     DateTime       @default(now())

  wishes          SongWish[]
  sessionSongs    JamSessionSong[]
  performanceLogs PerformanceLog[]

  @@index([title])
  @@index([artist])
}

model SongWish {
  id                  String   @id @default(cuid())
  musicianProfileId   String
  songId              String
  preferredInstrument String?
  preferredKey        String?
  notes               String?  @db.Text
  addedAt             DateTime @default(now())

  musicianProfile MusicianProfile @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  song            Song            @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([musicianProfileId, songId])
}

// ─────────────────────────────────────────────────────────────────────────────
// セッション / イベント（特定日時のイベント）
// v0.3: studioId / studioRoomId を追加（スタジオ開催に対応）
// ─────────────────────────────────────────────────────────────────────────────

enum SessionFormat {
  OPEN
  INVITE
  THEME
}

model JamSession {
  id                   String        @id @default(cuid())
  sessionAdminId       String
  sessionSeriesId      String?       // 定期セッションシリーズへの参照
  venueId              String?
  studioId             String?       // v0.3: スタジオ開催の場合
  studioRoomId         String?       // v0.3: 部屋指定
  title                String
  startsAt             DateTime
  durationMinutes      Int?
  format               SessionFormat @default(OPEN)
  isSyncroom           Boolean       @default(false)
  syncroomInfo         Json?
  moodFlags            String[]
  maxParticipants      Int?
  registrationRequired Boolean       @default(false)
  description          String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sessionAdmin    User                       @relation("SessionAdmin", fields: [sessionAdminId], references: [id])
  series          SessionSeries?             @relation(fields: [sessionSeriesId], references: [id])
  venue           Venue?                     @relation(fields: [venueId], references: [id])
  studio          Studio?                    @relation(fields: [studioId], references: [id])
  studioRoom      StudioRoom?                @relation(fields: [studioRoomId], references: [id])
  songs           JamSessionSong[]
  instrumentNeeds JamSessionInstrumentNeed[]
  registrations   JamSessionRegistration[]
  performanceLogs PerformanceLog[]
  privacySettings JamSessionPrivacySettings?
  adminConsent    JamSessionAdminConsent?
  kudos           Kudos[]
  feedback        AnonymousFeedback[]

  @@index([startsAt])
  @@index([venueId])
}

model JamSessionSong {
  id           String  @id @default(cuid())
  jamSessionId String
  songId       String
  keyOverride  String?
  bpmOverride  Int?
  orderIndex   Int     @default(0)

  jamSession JamSession @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)
  song       Song       @relation(fields: [songId], references: [id])

  @@index([jamSessionId])
}

model JamSessionInstrumentNeed {
  id           String @id @default(cuid())
  jamSessionId String
  instrument   String
  countNeeded  Int    @default(1)

  jamSession JamSession @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)
}

enum RegistrationStatus {
  INTERESTED
  CONFIRMED
  ATTENDED
}

model JamSessionRegistration {
  id                String             @id @default(cuid())
  jamSessionId      String
  musicianProfileId String
  status            RegistrationStatus @default(INTERESTED)
  registeredAt      DateTime           @default(now())

  jamSession      JamSession      @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)
  musicianProfile MusicianProfile @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)

  @@unique([jamSessionId, musicianProfileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AND-consent モデル（演奏ログ公開コントロール）
// ─────────────────────────────────────────────────────────────────────────────

model JamSessionPrivacySettings {
  id               String   @id @default(cuid())
  jamSessionId     String   @unique
  controlledById   String
  visSessionFact   Boolean  @default(false)
  visDatetime      Boolean  @default(false)
  visSessionName   Boolean  @default(false)
  visSongListVenue Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  jamSession JamSession @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)

  @@index([jamSessionId])
}

model JamSessionAdminConsent {
  id             String   @id @default(cuid())
  jamSessionId   String   @unique
  sessionAdminId String
  visSongList    Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  jamSession JamSession @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// 演奏ログ
// ─────────────────────────────────────────────────────────────────────────────

model PerformanceLog {
  id                String    @id @default(cuid())
  jamSessionId      String
  musicianProfileId String
  songId            String?
  registeredById    String
  instrumentPlayed  String?
  wasSoloist        Boolean   @default(false)
  orderInSession    Int?
  performedAt       DateTime?
  recordingUrl      String?   // 録音/演奏動画 URL（YouTube / SoundCloud 等）
  confirmed         Boolean   @default(false)
  confirmedAt       DateTime?
  visParticipation  Boolean   @default(false)
  visInstrument     Boolean   @default(false)
  visSongPerformance Boolean  @default(false)
  visCoPerformers   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  jamSession      JamSession      @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)
  musicianProfile MusicianProfile @relation(fields: [musicianProfileId], references: [id], onDelete: Cascade)
  song            Song?           @relation(fields: [songId], references: [id])
  registeredBy    User            @relation("LogRegistrar", fields: [registeredById], references: [id])

  @@index([jamSessionId])
  @@index([musicianProfileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// いいね！・フィードバック
// ─────────────────────────────────────────────────────────────────────────────

model Kudos {
  id           String   @id @default(cuid())
  jamSessionId String
  fromUserId   String
  toUserId     String?
  toVenueId    String?
  stamp        String
  message      String?  @db.Text
  createdAt    DateTime @default(now())

  jamSession JamSession @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)
  fromUser   User       @relation("KudosSender", fields: [fromUserId], references: [id])
  toUser     User?      @relation("KudosReceiver", fields: [toUserId], references: [id])
  toVenue    Venue?     @relation("KudosVenueReceiver", fields: [toVenueId], references: [id])

  @@unique([jamSessionId, fromUserId, toUserId])
  @@unique([jamSessionId, fromUserId, toVenueId])
  @@index([toUserId])
  @@index([toVenueId])
}

model AnonymousFeedback {
  id           String   @id @default(cuid())
  jamSessionId String
  toUserId     String?
  toVenueId    String?
  message      String   @db.Text
  createdAt    DateTime @default(now())

  jamSession JamSession @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)
  toUser     User?      @relation("FeedbackReceiver", fields: [toUserId], references: [id])
  toVenue    Venue?     @relation("FeedbackVenueReceiver", fields: [toVenueId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// ソーシャル
// ─────────────────────────────────────────────────────────────────────────────

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Connection {
  id            String           @id @default(cuid())
  fromUserId    String
  toUserId      String
  status        ConnectionStatus @default(PENDING)
  requestedAt   DateTime         @default(now())
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  rejectCount   Int              @default(0)
  cooldownUntil DateTime?        // 拒否後30日間の再申請クールダウン期限

  fromUser User @relation("ConnectionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnectionTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Block {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker User @relation("BlockedBy", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedAgainst", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 通知（バッチ配信 — ウィッシュリスト推測攻撃対策）
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationType {
  MATCH_SESSION
  MATCH_INSTRUMENT
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  KUDOS_RECEIVED
  LOG_CONFIRM_REQUEST
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  payload      Json
  sent         Boolean          @default(false)
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sent])
  @@index([scheduledFor, sent])
}

// ─────────────────────────────────────────────────────────────────────────────
// 定期セッションシリーズ（Phase 1）
// ─────────────────────────────────────────────────────────────────────────────

model SessionSeries {
  id              String        @id @default(cuid())
  hostId          String
  venueId         String?
  title           String
  description     String?       @db.Text
  rrule           String        // RFC 5545 RRULE 文字列 (e.g. "FREQ=WEEKLY;BYDAY=TH")
  startTime       String        // "19:00" 形式（時刻のみ）
  durationMinutes Int           @default(120)
  format          SessionFormat @default(OPEN)
  maxParticipants Int?
  isSyncroom      Boolean       @default(false)
  moodFlags       String[]
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  host     User         @relation("SeriesHost", fields: [hostId], references: [id])
  venue    Venue?       @relation(fields: [venueId], references: [id])
  sessions JamSession[]

  @@index([hostId])
  @@index([venueId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 会場なりすまし報告
// ─────────────────────────────────────────────────────────────────────────────

model VenueImpersonationReport {
  id          String   @id @default(cuid())
  venueId     String
  reporterId  String
  reason      String   @db.Text
  evidenceUrl String?
  status      String   @default("pending") // "pending" | "reviewed" | "resolved"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([venueId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ホスト主導マッチング（Phase 2）
// ─────────────────────────────────────────────────────────────────────────────

model HostAvailability {
  id              String   @id @default(cuid())
  hostId          String
  venueId         String?
  availableDate   DateTime
  startTime       String   // "19:00" 形式
  durationMinutes Int      @default(120)
  songIds         String[] // 弾ける曲の ID リスト
  instruments     String[] // 提供できる楽器
  notes           String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hostId])
  @@index([availableDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// 会場認証コード（一時保存 — メール確認コード）
// ─────────────────────────────────────────────────────────────────────────────

model VenueVerificationCode {
  id        String   @id @default(cuid())
  venueId   String
  claimerId String   // 申請者（会場オーナー候補）
  email     String   // 送信先メールアドレス（HP から抽出）
  code      String   // 6桁確認コード
  expiresAt DateTime // 発行から15分で失効
  createdAt DateTime @default(now())

  @@index([venueId, claimerId])
}
